{
  "info": {
    "name": "Cojauny Landing API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección para probar los endpoints principales de la landing de Cojauny"
  },
  "item": [
    {
      "name": "Enviar feedback",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Laura\",\n  \"email\": \"laura@example.com\",\n  \"message\": \"Me encanta la nueva experiencia\",\n  \"sentiment\": \"positive\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/feedback",
          "host": ["{{baseUrl}}"],
          "path": ["api", "feedback"]
        }
      }
    },
    {
      "name": "Registro beta",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Carlos Díaz\",\n  \"email\": \"carlos@example.com\",\n  \"company\": \"Cojauny\",\n  \"useCase\": \"Gestionar rutas compartidas\",\n  \"termsAccepted\": true\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/beta-signups",
          "host": ["{{baseUrl}}"],
          "path": ["api", "beta-signups"]
        }
      }
    },
    {
      "name": "Solicitud eliminación datos",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario@example.com\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/privacy/data-deletion",
          "host": ["{{baseUrl}}"],
          "path": ["api", "privacy", "data-deletion"]
        }
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ]
}
