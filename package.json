{
  "name": "cojauny-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page oficial de Cojauny construida con Next.js, Tailwind CSS y Supabase",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:ci": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --ci",
    "migrate:content": "tsx scripts/extract-current-site.ts",
    "supabase:backup": "tsx scripts/backup-supabase.ts",
    "seo:sitemap": "tsx scripts/generate-sitemap.ts",
    "seo:preflight": "npm run lint && npm run type-check",
    "deploy:verify": "tsx scripts/deploy-check.ts",
    "predeploy": "npm run lint && npm run build && tsx ./scripts/generate-rss.ts",
    "generate:rss": "tsx ./scripts/generate-rss.ts",
    "deploy": "firebase deploy --only hosting",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cojauny",
    "movilidad",
    "landing",
    "beta",
    "supabase",
    "zoho",
    "nextjs"
  ],
  "license": "MIT",
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.1.1",
    "@supabase/supabase-js": "^2.84.0",
    "cheerio": "^1.0.0-rc.12",
    "critters": "^0.0.23",
    "firebase-functions": "^7.0.1",
    "framer-motion": "^12.23.25",
    "next": "^16.0.9",
    "nodemailer": "^7.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "supabase": "^2.58.5",
    "uuid": "^9.0.1",
    "wicg-inert": "^3.1.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cheerio": "^0.22.35",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.25",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.16",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.6",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest-dom": "^5.0.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-testing-library": "^7.13.5",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.33",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
